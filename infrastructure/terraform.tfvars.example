aws_region  = "ap-northeast-1"
# aws_profile = "your-name"

# The domain must already be a public Route 53 hosted zone in this account.
# Defaults shown below — override only if using a different domain/subdomain.
# domain_name     = "gitenghar-live-chat.com"
# cable_subdomain = "cable"

# Required, sensitive — contents of message-api/config/master.key.
# Prefer `terraform apply -var="rails_master_key=$(cat ../message-api/config/master.key)"`
# over writing it into this file, even though *.tfvars is gitignored.
# rails_master_key = "changeme"
